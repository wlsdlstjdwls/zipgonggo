Thumbs.db

# 공고 첨부 텍스트 캐시(i-sh Synap 뷰어 XML) — 재배포 금지, 재수집 가능
pipeline/data/ish/

# 청년안심주택(민간임대) 첨부 공고문 PDF — s3_youth가 받아 둔 원본
pipeline/data/youth/

# LH 첨부 공급주택목록 엑셀 — s3_lh_units가 받아 둔 원본. 47MB짜리도 있다
pipeline/data/lh/

# OG 생성용 글꼴 — 필요할 때 내려받는다(design/brand/README.md)
design/brand/Pretendard-*.otf

# Cloudflare Worker 부산물
.wrangler/
worker/.dev.vars

# 도면 자산 — 원본 zip이 수백 MB다
pipeline/data/plans/

# SH주택정보 단지 이미지 — 평면도 1장이 400KB다
pipeline/data/sh-house/

# PoC 동안 SH 이미지를 여기로 복사해 지면에서 읽는다. 발행 때 스토리지로 옮긴다
web/public/sh-house/

# 청년안심주택 포털 단지 이미지 — 민간임대 축. 위와 같은 이유로 커밋하지 않는다
pipeline/data/youth-house/
web/public/youth-house/

# setuptools 편집 설치 부산물
*.egg-info/
