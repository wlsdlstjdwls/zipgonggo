# pipeline — 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.

# 공공데이터포털 활용신청 인증키 (Decoding 키)
# 마이홈포털 3종: 모집공고 15108420 / 단지정보 15110581 / 예비입주자 대기현황 15108378
# 개발계정 일 1,000건 제한. 운영계정 전환은 모집공고·대기현황이 자동승인, 단지정보만 심의승인이다.
DATA_GO_KR_KEY=

# Neon Postgres 접속 문자열 — Vercel이 주는 DATABASE_URL_UNPOOLED(direct) 값을 쓴다.
# 대량 COPY·마이그레이션은 pooler(pgbouncer)를 거치면 안 된다.
DATABASE_URL=

# 행안부 도로명주소 위치정보 요약DB 로컬 경로 (juso.go.kr 신청·승인 후 내려받은 파일)
# 전국본은 수백만 행이라 DB에 넣지 않고 여기서 오프라인 조인한다.
JUSO_SUMMARY_DB_PATH=./data/juso/

# 첨부파일 보관 경로
ATTACHMENT_DIR=./data/attachments/

# 스크래핑 요청 간격(초). 동시 요청을 걸지 않는다.
SCRAPE_DELAY_SEC=1.0

# 행안부 도로명주소 검색 API 승인키 (business.juso.go.kr → 주소정보 API 연계 → API 신청)
# 공고 주소 → 표준 도로명·도로명코드·건물번호 정규화 전용. 좌표제공 API는 실시간만 허용이라 쓰지 않는다
JUSO_SEARCH_API_KEY=

# 스테이지가 DB를 갱신하면(dry-run 아닐 때) 이 URL로 웹 캐시를 즉시 비운다.
# 배포된 웹이 없는 로컬 개발에선 둘 다 비워 둔다 — 조용히 건너뛰고 예전처럼 최대 1시간 뒤 자연 반영된다.
WEB_REVALIDATE_URL=https://zipgonggo.com/api/revalidate
# web/.env.local(또는 Vercel 환경변수)의 REVALIDATE_SECRET과 같은 값이어야 한다.
REVALIDATE_SECRET=
