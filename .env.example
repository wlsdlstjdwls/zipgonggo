# 루트 .env.example — 실제 값은 web/.env.local, pipeline/.env 에 넣는다.
# 여기는 프로젝트 전체에서 필요한 키의 목록 역할.
# 절대 실제 키를 이 파일에 쓰지 않는다.

# Neon Postgres (web · pipeline 공용)
DATABASE_URL=

# 공공데이터포털 인증키 (pipeline)
DATA_GO_KR_KEY=

# 네이버 Cloud Maps 클라이언트 ID (web)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 사이트 절대 URL (web)
NEXT_PUBLIC_SITE_URL=https://zipgonggo.com

# SH 단지 사진·도면 파일 자리 (web). 로컬은 비워 두면 web/public/sh-house.
# 배포는 비워 두면 갤러리를 그리지 않는다 — 스토리지에 올린 뒤 그 공개 URL을 넣는다(docs/data-sources.md 필요한 키)
NEXT_PUBLIC_SH_HOUSE_BASE=

# 청년안심주택(민간임대) 단지 사진·평면도 파일 자리 (web). 로컬은 비워 두면 web/public/youth-house.
# SH와 따로 두는 이유는 저작권 확인이 기관별로 따로 끝나기 때문이다(docs/data-sources.md 2d)
NEXT_PUBLIC_YOUTH_HOUSE_BASE=

# Vercel Blob 쓰기 토큰 (web/scripts/upload-sh-house.mjs 전용). 대시보드 Storage → Blob 스토어에서 받는다
BLOB_READ_WRITE_TOKEN=

# 행안부 도로명주소 검색 API 승인키 (pipeline)
JUSO_SEARCH_API_KEY=

# GitHub 크론이 회차를 건너뛸 때를 위한 바깥 방아쇠 — web /api/cron/{collect|patrol}
# 쓰지 않으면 셋 다 비워 둔다. 라우트가 501로 답하고 아무 일도 안 한다
CRON_TRIGGER_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=wlsdlstjdwls/zipgonggo

# 검색엔진 사이트 소유확인 코드 (web). 지금 값은 web/src/lib/constants.ts에 박혀 있고, 여기는 덮어쓰기용
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
