# web — 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 커밋하지 않는다.

# Neon Postgres 접속 문자열 — Vercel Marketplace Neon이 주입하는 pooled DATABASE_URL.
# 로컬은 `vercel env pull <임시파일>`로 받아 이 키만 옮긴다 (.env.local 통째 덮어쓰기 주의).
DATABASE_URL=

# 네이버 Cloud Platform > Application Services > Maps
# 발급 후 콘솔에서 Web Dynamic Map 월 무료 한도를 확인할 것.
# 이 서비스는 지도가 모든 페이지에 뜨므로 지도 로드 수 = 페이지뷰다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 사이트맵·canonical에 쓸 절대 URL — 프리뷰/로컬 오버라이드 전용.
# 프로덕션(VERCEL_ENV=production)은 이 값과 무관하게 https://zipgonggo.com 으로 고정된다 (src/lib/site-url.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# POST /api/revalidate 보호용 비밀키. 파이프라인이 DB를 갱신한 직후 이 값으로 웹 캐시를 즉시 비운다
# (pipeline/.env의 REVALIDATE_SECRET과 같은 값이어야 한다). 비워 두면 라우트가 501로 거절한다.
REVALIDATE_SECRET=

# 검색엔진 사이트 소유확인 코드(둘 다 <meta>로 나간다 — 비밀값 아님).
# **지금 쓰는 값은 src/lib/constants.ts에 기본값으로 박혀 있다.** 여기는 덮어쓰기 용도다 —
# 속성을 새로 파거나 도메인을 옮길 때만 채운다. 비워 두면 그 기본값이 나간다.
# 구글: search.google.com/search-console → 속성 추가 → HTML 태그 → content= 안의 문자열만.
# 네이버: searchadvisor.naver.com → 웹마스터도구 → 사이트 등록 → HTML 태그 → content= 안의 문자열만.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# 관리자 콘솔(/admin) 출입 토큰. 비워 두면 콘솔이 통째로 404다 — 빈 값끼리 맞아떨어지는 사고 방지.
# 운영자 한 사람만 쓰는 화면이라 계정 대신 이 토큰 하나를 쓴다. 길게 잡을 것(32자 이상 권장).
ADMIN_TOKEN=

# 바깥 크론 방아쇠(/api/cron/{잡})와 콘솔의 「지금 돌리기」가 GitHub 워크플로를 부를 때 쓴다.
# CRON_TRIGGER_SECRET: 방아쇠 URL 보호용(콘솔은 로그인 쿠키로 확인하므로 이 값이 필요 없다).
# GITHUB_DISPATCH_TOKEN: actions:write 권한 PAT. GITHUB_REPO: "사용자/저장소".
# 셋 중 뒤 둘이 비면 dispatch가 501로 거절한다(읽기 화면은 그대로 뜬다).
CRON_TRIGGER_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
