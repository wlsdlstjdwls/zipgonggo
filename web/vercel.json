{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/patrol",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/rollover",
      "schedule": "5 15 * * *"
    },
    {
      "path": "/api/cron/purge-profiles",
      "schedule": "40 19 * * *"
    }
  ]
}
